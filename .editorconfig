# Shared editor settings. Line endings in git are governed by .gitattributes;
# this keeps editors writing the same thing.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[scripts/*.js]
indent_size = 2

[package.json]
indent_size = 2

[package-lock.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
